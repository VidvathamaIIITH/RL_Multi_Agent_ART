# ═══════════════════════════════════════════════════
# Computational Creativity Chatbot — Environment
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your TWO OpenAI API keys:
#   copy .env.example .env
#
# Get your API keys at: https://platform.openai.com/api-keys
#
# Agent A (Impressionist painter) uses KEY 1:
OPENAI_API_KEY_AGENT_A=sk-paste-your-first-openai-key-here

# Agent B (Cubist painter) + Critic Agent uses KEY 2:
OPENAI_API_KEY_AGENT_B=sk-paste-your-second-openai-key-here
